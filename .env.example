# Copy to .env for local development. Vite loads it automatically.
BETTER_AUTH_URL=http://localhost:3000
# Replace with a random secret, e.g. node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
BETTER_AUTH_SECRET=

# Omit COUCHDB_URL to use the file-backed local development mode.
# Start CouchDB with docker compose up -d --wait, then uncomment this line
# and run npm run db:init. The application runs on the host with npm run dev.
# COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_DATABASE=timestripe
COUCHDB_USER=timestripe
COUCHDB_PASSWORD=local-timestripe-change-me

# Optional local data directory. Never expose this through a static web server.
TIMESTRIPE_DATA_DIR=.data
# Only for an explicitly chosen single-process production preview without CouchDB:
# TIMESTRIPE_LOCAL_DEMO=true
# Optional profile-picture uploads to an existing public Backblaze B2 bucket.
S3_SECRET=
S3_KEYID=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
